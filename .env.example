# --- Required ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server only: used by webhooks
ANTHROPIC_API_KEY=                # Claude writes emails + reads replies
ANTHROPIC_WORKSPACE_ID=           # only for personal (sk-ant-usr-) keys: the workspace to use, wrkspc_...
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Lead sources ---
GOOGLE_PLACES_API_KEY=            # real businesses with ratings; without it the free (slower) OpenStreetMap search is used
APOLLO_API_KEY=

# --- Email (leave empty to simulate sending) ---
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=            # from the Resend inbound webhook (whsec_...)
INBOUND_DOMAIN=                   # receiving domain in Resend, e.g. in.youragency.com
NOTIFY_FROM_EMAIL=                # e.g. LeadSwipe <alerts@youragency.com>
